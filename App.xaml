<Application x:Class="MyPiggyBank.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MyPiggyBank">
 <Application.Resources>
  <local:SelectionLabelConverter x:Key="SelectionLabel"/>
  <SolidColorBrush x:Key="Accent" Color="#B51B72"/>
  <SolidColorBrush x:Key="WorkspaceMuted" Color="#626777"/>
  <SolidColorBrush x:Key="WorkspaceOnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="WorkspaceSurface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="WorkspaceOutline" Color="#CFD2DC"/>
  <SolidColorBrush x:Key="WorkspaceInk" Color="#202231"/>
  <SolidColorBrush x:Key="WorkspaceFocus" Color="#B51B72"/>
  <SolidColorBrush x:Key="WorkspaceSelect" Color="#F7E8F1"/>
  <SolidColorBrush x:Key="WorkspaceLedgerHover" Color="#FAF0F6"/>
  <SolidColorBrush x:Key="WorkspaceLedgerSelection" Color="#F0D5E5"/>
  <SolidColorBrush x:Key="WorkspaceLedgerHeader" Color="#F3F3F6"/>
  <SolidColorBrush x:Key="WorkspaceLedgerHeaderInk" Color="#424553"/>
  <SolidColorBrush x:Key="WorkspaceLedgerRule" Color="#E2E3EA"/>
  <Style x:Key="WorkspaceCalendarButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource WorkspaceInk}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1" CornerRadius="4" Padding="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSelect}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WorkspaceCalendarDay" TargetType="CalendarDayButton" BasedOn="{StaticResource WorkspaceCalendarButton}">
   <Style.Triggers>
    <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}"/></Trigger>
    <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/></Trigger>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="{DynamicResource WorkspaceFocus}"/>
     <Setter Property="Foreground" Value="{DynamicResource WorkspaceOnAccent}"/>
    </Trigger>
    <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkspaceCalendarPeriod" TargetType="CalendarButton" BasedOn="{StaticResource WorkspaceCalendarButton}">
   <Style.Triggers>
    <Trigger Property="HasSelectedDays" Value="True"><Setter Property="Background" Value="{DynamicResource WorkspaceSelect}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkspaceCalendarItem" TargetType="CalendarItem">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CalendarItem">
      <ControlTemplate.Resources>
       <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
        <TextBlock Text="{Binding}" Foreground="{DynamicResource WorkspaceMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </DataTemplate>
      </ControlTemplate.Resources>
      <Grid x:Name="PART_Root" Width="252">
       <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="196"/></Grid.RowDefinitions>
       <DockPanel LastChildFill="True">
        <Button x:Name="PART_PreviousButton" DockPanel.Dock="Left" Width="32" Content="‹"
                AutomationProperties.Name="Previous" Style="{StaticResource WorkspaceCalendarButton}"/>
        <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Width="32" Content="›"
                AutomationProperties.Name="Next" Style="{StaticResource WorkspaceCalendarButton}"/>
        <Button x:Name="PART_HeaderButton" FontWeight="SemiBold" Style="{StaticResource WorkspaceCalendarButton}"/>
       </DockPanel>
       <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
         <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
         <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
         <RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>
       </Grid>
       <Grid x:Name="PART_YearView" Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       </Grid>
       <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers>
       <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Month">
        <Setter TargetName="PART_MonthView" Property="Visibility" Value="Visible"/>
        <Setter TargetName="PART_YearView" Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WorkspaceScrollRepeat" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RepeatButton">
      <Border Background="Transparent">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WorkspaceScrollbar" TargetType="ScrollBar">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <DockPanel Background="Transparent">
       <RepeatButton x:Name="back" DockPanel.Dock="Top" Width="16" Height="16"
                     Command="{x:Static ScrollBar.LineUpCommand}" Style="{StaticResource WorkspaceScrollRepeat}">
        <Path x:Name="backGlyph" Data="M 0,4 L 4,0 8,4" Stroke="{DynamicResource WorkspaceInk}" StrokeThickness="1"/>
       </RepeatButton>
       <RepeatButton x:Name="forward" DockPanel.Dock="Bottom" Width="16" Height="16"
                     Command="{x:Static ScrollBar.LineDownCommand}" Style="{StaticResource WorkspaceScrollRepeat}">
        <Path x:Name="forwardGlyph" Data="M 0,0 L 4,4 8,0" Stroke="{DynamicResource WorkspaceInk}" StrokeThickness="1"/>
       </RepeatButton>
       <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
         <RepeatButton x:Name="pageBack" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource WorkspaceScrollRepeat}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb>
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border x:Name="pill" Margin="5,2" CornerRadius="3" Background="{DynamicResource WorkspaceScrollThumb}"/>
            <ControlTemplate.Triggers>
             <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
              <Setter TargetName="pill" Property="Margin" Value="2,5"/>
             </DataTrigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton x:Name="pageForward" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource WorkspaceScrollRepeat}"/>
        </Track.IncreaseRepeatButton>
       </Track>
      </DockPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="Orientation" Value="Horizontal">
        <Setter TargetName="back" Property="DockPanel.Dock" Value="Left"/>
        <Setter TargetName="forward" Property="DockPanel.Dock" Value="Right"/>
        <Setter TargetName="backGlyph" Property="Data" Value="M 4,0 L 0,4 4,8"/>
        <Setter TargetName="forwardGlyph" Property="Data" Value="M 0,0 L 4,4 0,8"/>
        <Setter TargetName="back" Property="Command" Value="{x:Static ScrollBar.LineLeftCommand}"/>
        <Setter TargetName="forward" Property="Command" Value="{x:Static ScrollBar.LineRightCommand}"/>
        <Setter TargetName="pageBack" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
        <Setter TargetName="pageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="WorkspaceSplitter" TargetType="GridSplitter">
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="ResizeDirection" Value="Columns"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="GridSplitter">
      <Border Background="Transparent">
       <Border x:Name="rule" Width="1" Background="{TemplateBinding Background}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="rule" Property="Background" Value="{DynamicResource WorkspaceFocus}"/>
        <Setter TargetName="rule" Property="Width" Value="2"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="rule" Property="Background" Value="{DynamicResource WorkspaceFocus}"/>
        <Setter TargetName="rule" Property="Width" Value="2"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <DataTemplate x:Key="WorkspaceBankName">
   <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
  </DataTemplate>
  <Style x:Key="WorkspaceThemeSwitch" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
       <Border x:Name="track" Width="30" Height="16" CornerRadius="8"
               Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
        <Ellipse x:Name="thumb" Width="10" Height="10" Margin="2,0" HorizontalAlignment="Left"
                 VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
       </Border>
       <Border x:Name="focus" Width="36" Height="22" CornerRadius="11" Visibility="Collapsed"
               BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="track" Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter TargetName="track" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter TargetName="thumb" Property="Fill" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
        <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Geometry x:Key="OverviewOrnament">M7 66 C25 45 39 42 55 48 C64 51 69 43 75 36 C82 28 90 27 99 31 C109 17 126 16 136 25 C146 25 153 31 154 39 C166 35 178 39 183 47 C190 51 200 50 211 45 C207 57 196 62 185 61 C176 69 165 73 153 69 C145 78 132 80 121 74 C110 80 98 78 89 72 C78 76 66 72 58 66 C45 57 27 56 7 66 Z M27 62 C43 53 54 58 64 59 C75 60 78 47 87 43 C94 39 100 43 105 46 C113 31 127 30 135 38 C146 37 151 44 149 51 C158 46 172 49 176 55 C184 59 192 56 198 54 C190 62 180 64 171 61 C161 70 150 67 142 63 C133 71 120 70 112 64 C103 69 92 66 84 61 C74 66 66 65 57 61 C47 57 38 59 27 62 M105 54 C112 46 121 45 127 51 C132 56 128 62 122 62 C117 62 115 58 118 55</Geometry>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#202231"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D4D6DE"/><Setter Property="Foreground" Value="#202231"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><Border x:Name="focus" Margin="2" BorderThickness="1" BorderBrush="#B51B72" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="box" Property="Background" Value="#F8EAF2"/><Setter Property="Foreground" Value="#9E1463"/></MultiTrigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Background" Value="#EBC8DC"/><Setter Property="Foreground" Value="#7D104E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WorkspaceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid>
       <Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
               BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="8">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
       </Border>
       <Border x:Name="overlay" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
       <Border x:Name="focus" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2" Margin="2"
               CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="Tag" Value="Square">
        <Setter TargetName="surface" Property="CornerRadius" Value="0"/>
        <Setter TargetName="overlay" Property="CornerRadius" Value="0"/>
        <Setter TargetName="focus" Property="CornerRadius" Value="0"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="overlay" Property="Opacity" Value="0.08"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="overlay" Property="Opacity" Value="0.16"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource WorkspaceInk}"/><Setter Property="Background" Value="{DynamicResource WorkspaceSurface}"/><Setter Property="CaretBrush" Value="{DynamicResource WorkspaceInk}"/><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceOutline}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="WorkspaceDialogTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
       <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="TextWrapping" Value="Wrap">
        <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="TextWrapping" Value="Wrap"><Setter Property="VerticalContentAlignment" Value="Top"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WorkspaceDialogCheckBox" TargetType="CheckBox">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <StackPanel Background="Transparent" Orientation="Horizontal">
       <Border x:Name="box" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
               CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource WorkspaceOutline}">
        <Path x:Name="tick" Data="M 0,4 L 3,7 9,0" StrokeThickness="1.5"
              Stroke="{DynamicResource WorkspaceOnAccent}" HorizontalAlignment="Center"
              VerticalAlignment="Center" Visibility="Collapsed"/>
       </Border>
       <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="box" Property="Background" Value="{DynamicResource WorkspaceFocus}"/>
        <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/>
        <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="MoneyInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="moneyBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/><TextBlock x:Name="watermark" Margin="{TemplateBinding Padding}" Text="Rp 0.00" Foreground="{DynamicResource WorkspaceMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="watermark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="moneyBorder" Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource WorkspaceInk}"/>
   <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource WorkspaceSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceOutline}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="comboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/><TextBlock Margin="12,4,32,4" VerticalAlignment="Center" Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SelectionLabel}}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Width="14" Height="8" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform" Data="M0,0 L7,7 14,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" StrokeThickness="1.5"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="comboBorder" Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
